name: Cleanup.txt.bak files

on:
  push:
    branches: [ main, master ]
  pull_request:
  workflow_dispatch:

jobs:
  cleanup:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Delete *.txt.bak in pamphletTXT
        run: |
          echo "Searching for *.txt.bak files in pamphletTXT..."
          find pamphletTXT -type f -name "*.txt.bak" -print
          find pamphletTXT -type f -name "*.txt.bak" -delete
          echo "Done."

      - name: Commit and push if deleted
        run: |
          if [[ -n $(git status --porcelain) ]]; then
            git config user.name "github-actions[bot]"
            git config user.email "github-actions[bot]@users.noreply.github.com"
            git add -A
            git commit -m "chore: remove *.txt.bak files from pamphletTXT"
            git push
          else
            echo "No bak files to remove."
          fi
